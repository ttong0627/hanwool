POSTGRES_USER=hanwool
POSTGRES_PASSWORD=change-this-to-a-random-strong-password
DATABASE_URL=postgresql+asyncpg://hanwool:change-this-to-a-random-strong-password@localhost:5432/hanwool_db
REDIS_URL=redis://localhost:6379/0

# ⚠️  반드시 안전한 값으로 변경하세요 — 기본값으로 서버가 시작되지 않습니다
# python -c "import secrets; print(secrets.token_hex(32))" 로 생성
SECRET_KEY=여기에_64자_이상의_랜덤_문자열_입력
AES_KEY=여기에_32자_이상의_랜덤_문자열_입력_꼭_32자이상

ALGORITHM=HS256
# 액세스 토큰 유효시간(분). 기사앱 편의를 위해 7일(10080)로 운영 — 구버전 앱도 재로그인 최소화.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7
KAKAO_REST_API_KEY=your-kakao-rest-api-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
ALLOW_DEMO_SEED=false

# Optional only when running create_admin.py non-interactively.
# HANWOOL_ADMIN_NAME=
# HANWOOL_ADMIN_PHONE=
# HANWOOL_ADMIN_PASSWORD=
